#!/usr/bin/env bash
# fatllm: manage FATLLM (full server access for AI agents) on this server.
# On the hub: keys, connected servers, port, certificate. On a connected server: its link to the hub.
# Output is English on purpose: phone SSH apps show Persian badly.
set -euo pipefail

CONF="${FATLLM_CONF:-/etc/fatllm/fatllm.env}"
APP="${FATLLM_APP:-/opt/fatllm}"
RAW="${FATLLM_RAW:-https://raw.githubusercontent.com/SaeedCrazy/FATLLM-FULL-ACCESS-TO-LLM-/HEAD}"
SELF="$(readlink -f "$0" 2>/dev/null || echo "$0")"
PY="$(command -v python3 || echo python3)"

# ------------------------------------------------------------------ look (server/ui.sh)
UI_FILE=""
for f in "$APP/ui.sh" "$(dirname "$SELF")/ui.sh"; do [ -f "$f" ] && { UI_FILE="$f"; break; }; done
if [ -n "$UI_FILE" ]; then
  # shellcheck source=server/ui.sh
  . "$UI_FILE"
  ui_init
else  # plain fallback
  R="" B="" D="" G="" C="" Y="" RD="" M="" A="" UI_COLS=80 UI_W=60 UI_TTY=0 S_ELL="..." S_DOT="*"
  say() { printf '> %s\n' "$*"; }
  ok() { printf '+ %s\n' "$*"; }
  note() { printf '  %s\n' "$*"; }
  warn() { printf '! %s\n' "$*" >&2; }
  die() { printf 'ERROR: %s\n' "$*" >&2; exit 1; }
  ui_logo() { printf '\nFATLLM - %s\n\n' "${1:-full server access for AI agents}"; }
  ui_rule() { printf '  ----------------------------------------\n'; }
  ui_head() { printf '\n  %s  %s\n' "$1" "${2:-}"; }
  ui_kv() { printf '  %-9s %s\n' "$1" "$2"; }
  ui_cmd() { printf '  %-19s %s\n' "$1" "$2"; }
  ui_dot() { local m="*"; [ "$1" = bad ] && m="x"; [ "$1" = off ] && m="o"; printf '  %s %-10s %s\n' "$m" "$2" "$3"; }
  ui_box() { printf '  %s\n' "$2"; }
  ui_wait() { sleep "$2"; }
  ui_spin() { :; }
  ui_spin_end() { :; }
fi

# ------------------------------------------------------------------ helpers
need_root() { [ "$(id -u)" = 0 ] || die "run as root: sudo fatllm $*"; }
# shellcheck disable=SC1090
load() { [ -f "$CONF" ] || die "FATLLM is not installed here."; set -a; . "$CONF"; set +a; }
is_node() { [ "${FATLLM_ROLE:-hub}" = node ]; }
adm() {  # agent.py admin ... (settings come from the sourced env file); its errors as a red line
  local err rc=0 msg
  err="$(mktemp)"
  "$PY" "$APP/agent.py" admin "$@" 2>"$err" || rc=$?
  if [ "$rc" != 0 ]; then
    msg="$(tail -n 2 "$err" | tr '\n' ' ')"
    ui_spin_end
    printf '%s\n' "${msg:-failed}" | fold -s -w $(( ${UI_COLS:-80} - 6 )) | sed "1s/^/  ${RD}${S_BAD:-x}${R} /; 2,\$s/^/    /" >&2
  fi
  rm -f "$err"
  return "$rc"
}
api() { adm api "$@"; }                             # this server's agent (root-only token)
jq_py() {  # jq_py 'python code using d and sys.argv[1:]' [args] < json
  local code="$1"; shift
  "$PY" -c "import json, sys, time
d = json.load(sys.stdin)
$code" "$@"
}
fmt_time() { date -d "@$1" '+%Y-%m-%d %H:%M' 2>/dev/null || echo "$1"; }
ago() {  # seconds -> 3m / 2h / 5d
  local s="$1"
  if [ "$s" -lt 120 ]; then echo "${s}s"; elif [ "$s" -lt 7200 ]; then echo "$(( s / 60 ))m"
  elif [ "$s" -lt 172800 ]; then echo "$(( s / 3600 ))h"; else echo "$(( s / 86400 ))d"; fi
}
agent_up() { systemctl is-active --quiet fatllm 2>/dev/null; }
mode_label() { if [ "${FATLLM_MODE:-direct}" = cert ]; then echo "public certificate"; else echo "self-signed"; fi; }
units() { if [ "${FATLLM_MODE:-direct}" = cert ]; then echo "fatllm fatllm-caddy"; else echo fatllm; fi; }
US=$'\037'
valid_name() { [[ "$1" =~ ^[a-zA-Z0-9][a-zA-Z0-9_-]{0,31}$ ]]; }

run_installer() {  # the latest install.sh with these options (keeps keys, port and servers)
  local tmp; tmp="$(mktemp -d)"
  if [ -n "${FATLLM_LOCAL_SRC:-}" ]; then cp "$FATLLM_LOCAL_SRC/install.sh" "$tmp/install.sh"; set -- --local "$@"
  else curl -fsSL --retry 3 "$RAW/install.sh" -o "$tmp/install.sh" || { rm -rf "$tmp"; die "download failed: $RAW/install.sh"; }; fi
  bash "$tmp/install.sh" "$@" || { rm -rf "$tmp"; exit 1; }
  rm -rf "$tmp"
}

# expiry of one key, as words
key_expiry() {  # name -> "never" / "2026-11-20 10:00" / "EXPIRED"
  adm keys | jq_py '
for k in d:
    if k["name"] == sys.argv[1]:
        e = k.get("expires") or 0
        print("never" if not e else ("EXPIRED" if e < time.time() else time.strftime("%Y-%m-%d %H:%M", time.localtime(e))))' "$1" 2>/dev/null \
    || echo "?"
}

# servers, one per line: name US state US detail (US = the unit separator: fields may be empty)
servers_tsv() {
  api GET '/servers?json=1' | jq_py '
for s in d["servers"]:
    if s.get("self"):
        st, det = "hub", s.get("os") or ""
    elif s.get("online"):
        st, det = "online", s.get("os") or ""
        if s.get("version") and s.get("version") != d["servers"][0].get("version"):
            det = "old version %s, run: fatllm update" % s["version"]
    elif s.get("joining"):
        st, det = "joining", "waiting for the join line"
    else:
        st, det = "offline", "never connected"
        if s.get("last_seen"):
            x = int(time.time() - s["last_seen"])
            det = "last seen %s ago" % ("%dm" % (x // 60) if x < 7200 else "%dh" % (x // 3600) if x < 172800 else "%dd" % (x // 86400))
    print("\x1f".join((s["name"], st, det)))'
}

print_servers() {
  local name st det out
  if ! out="$(servers_tsv 2>/dev/null)"; then warn "The agent is not running (fatllm on)."; return 1; fi
  while IFS=$US read -r name st det; do
    case "$st" in
      hub) ui_dot good "$name" "hub $S_DOT_SEP $det" ;;
      online) ui_dot good "$name" "online $S_DOT_SEP $det" ;;
      joining) ui_dot warn "$name" "$det" ;;
      *) ui_dot bad "$name" "offline $S_DOT_SEP $det" ;;
    esac
  done <<<"$out"
}
S_DOT_SEP="·"; [ "${UI_U:-1}" = 1 ] || S_DOT_SEP="-"

# ------------------------------------------------------------------ hub: key / status / log
show_key() {  # [key name]
  local name="${1:-}" url exp
  url="$(adm show ${name:+"$name"})" || exit 1
  exp="$(key_expiry "${name:-main}")"
  ui_head "KEY" "${name:+"$name · "}give the whole line to your AI"
  printf '  %s%sFATLLM key: %s%s\n' "$G" "$B" "$url" "$R"
  ui_head "PANEL" "open it in your phone's browser"
  printf '  %s%s/panel%s\n' "$C" "$url" "$R"
  if [ "${FATLLM_MODE:-direct}" = cert ]; then
    ui_head "MCP" "claude.ai / ChatGPT connector"
    printf '  %s/mcp\n' "$url"
  fi
  echo
  ui_rule
  ui_kv "expires" "$exp"
  ui_kv "gives" "root on all connected servers"
  ui_kv "keep" "it secret, like a password"
  ui_rule
  if [ "${FATLLM_MODE:-direct}" != cert ]; then
    note "Self-signed certificate: the browser warns"
    note "once (Advanced > Proceed). That's normal."
  fi
  [ "$exp" = EXPIRED ] && warn "This key has expired: fatllm expire never"
  echo
}

last_action() {
  local line
  line="$(adm log 400 2>/dev/null | awk -F'\037' '$3=="run"' | tail -n 1 || true)"
  [ -n "$line" ] || { echo none; return; }
  IFS=$US read -r d t _ on det <<<"$line"
  det="$d $t [$on] $det"
  [ "${#det}" -gt $(( UI_W - 14 )) ] && det="${det:0:$(( UI_W - 15 ))}${S_ELL:-...}"
  echo "$det"
}

show_status() {
  local bad=0 u n_keys
  ui_head "STATUS" "hub \"${FATLLM_NAME:-main}\" $S_DOT_SEP $(hostname 2>/dev/null || echo server)"
  echo
  for u in $(units); do
    local label=agent; [ "$u" = fatllm-caddy ] && label=https
    if systemctl is-active --quiet "$u" 2>/dev/null; then ui_dot good "$label" "running"
    else ui_dot bad "$label" "$(systemctl is-active "$u" 2>/dev/null || echo stopped)"; bad=1; fi
  done
  if api GET /info >/dev/null 2>&1; then ui_dot good "self-test" "answers on port ${FATLLM_PORT:-?}"
  else ui_dot bad "self-test" "no answer"; bad=1; fi
  ui_head "SERVERS"
  print_servers || true
  echo
  ui_rule
  n_keys="$(adm keys | jq_py 'print(len(d))' 2>/dev/null || echo '?')"
  ui_kv "address" "${FATLLM_PUBLIC_URL:-?}"
  ui_kv "cert" "$(mode_label)"
  ui_kv "keys" "$n_keys $S_DOT_SEP main: $(key_expiry main)"
  ui_kv "last" "$(last_action)"
  ui_rule
  note "Not reachable? Open TCP port ${FATLLM_PORT:-?} in"
  note "your provider's firewall panel."
  [ "$bad" = 0 ] || note "details: journalctl -u fatllm -n 50"
  echo
}

show_log() {  # [N] [server]
  local n="${1:-40}" on="${2:-}" d t act srv det col w out lab
  [[ "$n" =~ ^[0-9]+$ ]] || n=40
  out="$(adm log "$n" ${on:+"$on"} 2>/dev/null || true)"
  [ -n "$out" ] || { note "Nothing yet."; return 0; }
  w=$(( UI_COLS - 21 )); [ "$w" -lt 16 ] && w=16
  ui_head "ACTIVITY" "last $n, newest last (UTC)"
  echo
  while IFS=$US read -r d t act srv det; do
    lab="$act"; [ -n "$srv" ] && srv="[$srv] "
    case "$act" in
      run) col="$C"; det="$srv$det" ;;
      done) if [[ "$det" == "exit 0 "* ]]; then col="$G"; det="$srv${S_OK:-ok} ${det#exit 0 }"
            else col="$RD"; det="$srv${S_BAD:-x} $det"; fi ;;
      read | write) col="$M"; det="$srv$det" ;;
      server-online) col="$G"; lab=online; det="${srv}connected" ;;
      server-add) col="$Y"; lab=invite; det="${srv}join line made" ;;
      join-download) col="$Y"; lab="join"; det="${srv}installing" ;;
      server-remove | server-left) col="$RD"; lab=remove; det="${srv}removed" ;;
      hub-moved) col="$Y"; lab=moved; det="$srv$det" ;;
      key-add | key-remove | rotate | expire) col="$Y"; lab="${act/key-add/key+}"; lab="${lab/key-remove/key-}"; det="${det#@server}" ;;
      kill | off) col="$RD"; det="$srv${det#@server}" ;;
      *) col="$Y"; det="$srv${det#@server}" ;;
    esac
    [ "${#det}" -gt "$w" ] && det="${det:0:$(( w - 1 ))}${S_ELL:-...}"
    printf '  %s%s %s%s %s%-6.6s%s %s\n' "$D" "$d" "$t" "$R" "$col" "$lab" "$R" "$det"
  done <<<"$out"
  echo
}

# ------------------------------------------------------------------ hub: servers
add_server() {  # NAME [--no-wait]
  local name="${1:-}" out cmd i st
  [ -n "$name" ] || die "usage: fatllm add-server NAME   (a short name, e.g. iran)"
  valid_name "$name" || die "a name uses letters, digits, - and _ (e.g. iran, de-1)"
  [ "$name" != "${FATLLM_NAME:-main}" ] || die "'$name' is this hub's own name; pick another"
  agent_up || die "FATLLM is off here. Turn it on first: fatllm on"
  out="$(api POST /admin/servers "{\"name\": \"$name\"}")" || exit 1
  cmd="$(printf '%s' "$out" | jq_py 'print(d["command"])')"
  ui_head "ADD SERVER" "$name"
  echo
  note "1. SSH into the other server as root."
  note "2. Paste this one line, press Enter:"
  echo
  printf '%s%s%s\n' "$G" "$cmd" "$R"
  echo
  ui_rule
  note "Works once, within 2 hours. The other"
  note "server dials out to this hub, so it needs"
  note "no open port (fine for a server in Iran)."
  ui_rule
  [ "${2:-}" = --no-wait ] && return 0
  [ "$UI_TTY" = 1 ] && [ -t 0 ] || return 0
  echo
  for i in $(seq 1 1800); do
    st="$(servers_tsv 2>/dev/null | awk -F'\037' -v n="$name" '$1==n{print $2}')"
    if [ "$st" = online ]; then
      ok "$name connected. Your AI can use it:"
      note "srv --on $name 'command'"
      echo; return 0
    fi
    ui_spin "Waiting for $name${S_ELL:-...} (Ctrl+C = stop)"
    sleep 0.5
    : "$i"
  done
  ui_spin_end
}

remove_server() {  # NAME [--uninstall]
  local name="${1:-}" body out
  [ -n "$name" ] || die "usage: fatllm remove-server NAME [--uninstall]"
  valid_name "$name" || die "no server named $name (fatllm servers lists them)"
  body="{\"name\": \"$name\"}"
  [ "${2:-}" = --uninstall ] && body="{\"name\": \"$name\", \"uninstall\": true}"
  out="$(api POST /admin/servers/remove "$body")" || exit 1
  ok "$name removed. Its access ended."
  if printf '%s' "$out" | grep -q '"uninstalled": true'; then ok "FATLLM was removed from $name too."
  elif [ "${2:-}" = --uninstall ]; then note "$name is offline: run 'fatllm leave' on it."; fi
}

# ------------------------------------------------------------------ hub: keys
show_keys() {
  local out name exp last cur
  if agent_up && out="$(api GET /admin/keys 2>/dev/null)"; then :; else out="$(adm keys | jq_py 'print(json.dumps({"keys": d}))')"; fi
  ui_head "KEYS" "every key is full access"
  echo
  while IFS=$US read -r name exp last cur; do
    if [ "$exp" = EXPIRED ]; then ui_dot bad "$name" "expired"
    else ui_dot good "$name" "$exp $S_DOT_SEP used $last"; fi
    : "$cur"
  done < <(printf '%s' "$out" | jq_py '
for k in d["keys"]:
    e = k.get("expires") or 0
    exp = "no expiry" if not e else ("EXPIRED" if e < time.time() else "until " + time.strftime("%m-%d %H:%M", time.localtime(e)))
    lu = k.get("last_used")
    last = "never" if not lu else ("%dm ago" % ((time.time() - lu) // 60) if time.time() - lu < 7200 else time.strftime("%m-%d", time.localtime(lu)))
    print("\x1f".join((k["name"], exp, last, str(k.get("current", False)))))')
  echo
  note "fatllm keys add NAME [7d]   a separate key"
  note "fatllm key NAME             show one"
  note "fatllm keys remove NAME     cut it off"
  echo
}

# ------------------------------------------------------------------ node (a server connected to a hub)
node_state() {  # TSV: connected hub error age
  adm node | jq_py '
print("\x1f".join((str(d.get("connected", False)), d.get("hub", ""), d.get("error", ""), str(int(time.time() - d.get("time", 0)) if d.get("time") else -1))))' 2>/dev/null \
    || printf 'False\037\037\037-1\n'
}

node_status() {
  local con err age
  IFS=$US read -r con _ err age < <(node_state)
  ui_head "STATUS" "\"${FATLLM_NAME:-?}\" $S_DOT_SEP connected server"
  echo
  if agent_up; then ui_dot good "agent" "running"; else ui_dot bad "agent" "stopped (fatllm on)"; fi
  if [ "$con" = True ] && [ "$age" -ge 0 ] && [ "$age" -lt 120 ]; then ui_dot good "hub" "connected"
  elif agent_up; then ui_dot bad "hub" "${err:-not connected yet}"
  else ui_dot off "hub" "-"; fi
  echo
  ui_rule
  ui_kv "hub" "${FATLLM_HUB:-?}"
  ui_kv "name" "${FATLLM_NAME:-?}"
  ui_rule
  note "It dials out to the hub: no open port"
  note "needed. Key and panel live on the hub."
  echo
}

node_leave() {  # [-y]
  if [ "${1:-}" != -y ]; then
    printf '  Remove FATLLM from this server? Type %syes%s: ' "$B" "$R"
    read -r ans </dev/tty || ans=""
    [ "$ans" = yes ] || { note "Cancelled."; exit 0; }
  fi
  if adm leave >/dev/null 2>&1; then ok "The hub forgot this server."
  else warn "The hub did not answer; remove it there too: fatllm remove-server ${FATLLM_NAME:-NAME}"; fi
  uninstall_local
}

uninstall_local() {
  systemctl disable --now fatllm fatllm-caddy >/dev/null 2>&1 || true
  rm -f /etc/systemd/system/fatllm.service /etc/systemd/system/fatllm-caddy.service
  systemctl daemon-reload
  rm -rf /opt/fatllm /etc/fatllm /var/lib/fatllm /var/log/fatllm
  rm -f /usr/local/bin/fatllm
  ok "FATLLM removed from this server."
}

# ------------------------------------------------------------------ interactive menu
ask() { local a; printf '%s' "$1" >&2; read -r a </dev/tty || a=""; printf '%s' "$a"; }
pause() { printf '\n  %sPress Enter to go back%s' "$D" "$R"; read -r _ </dev/tty || true; }
yes_no() { local a; a="$(ask "  $1 [y/N] ")"; [ "$a" = y ] || [ "$a" = Y ] || [ "$a" = yes ]; }
sub() { bash "$SELF" "$@" || true; }
clear_screen() { [ "$UI_TTY" = 1 ] && printf '\033[H\033[2J' || true; }

menu_items() {  # print "N|label" items in one or two columns
  local items=("$@") i half left right
  if [ "${UI_COLS:-80}" -ge 64 ]; then
    half=$(( (${#items[@]} + 1) / 2 ))
    for ((i = 0; i < half; i++)); do
      left="${items[i]}"; right="${items[i + half]:-}"
      printf '  %s%3s%s  %-24s' "$A" "${left%%|*}" "$R" "${left#*|}"
      [ -n "$right" ] && printf '%s%3s%s  %s' "$A" "${right%%|*}" "$R" "${right#*|}"
      echo
    done
  else
    for i in "${items[@]}"; do printf '  %s%3s%s  %s\n' "$A" "${i%%|*}" "$R" "${i#*|}"; done
  fi
  echo
}

hub_menu() {
  local ch onoff total online st kexp
  while true; do
    load
    clear_screen
    ui_logo "full server access for AI agents"
    total=1 online=1
    if agent_up; then
      st="${G}${S_DOT:-*} on${R}"
      while IFS=$US read -r _ s _; do
        [ "$s" = hub ] && continue
        [ "$s" = joining ] && continue
        total=$(( total + 1 )); [ "$s" = online ] && online=$(( online + 1 ))
      done < <(servers_tsv 2>/dev/null || true)
    else st="${RD}${S_DOT:-*} off${R}"; fi
    printf '  %s  %s%s%s  %s:%s %s %s%s\n' "$st" "$B" "${FATLLM_NAME:-main}" "$R" "$D" "${FATLLM_PORT:-?}" "$S_DOT_SEP" "$(mode_label)" "$R"
    kexp="$(key_expiry main)"; case "$kexp" in never) kexp="no expiry" ;; EXPIRED | "?") ;; *) kexp="until ${kexp#????-}" ;; esac
    printf '  %sservers%s %s/%s online  %skey%s %s\n' "$D" "$R" "$online" "$total" "$D" "$R" "$kexp"
    ui_rule
    echo
    if agent_up; then onoff="Turn access OFF"; else onoff="Turn access ON"; fi
    menu_items "1|Show key + panel" "2|Servers" "3|Connect a server" "4|Status & test" "5|Activity log" \
      "6|$onoff" "7|New key (rotate)" "8|Key expiry" "9|Extra keys" "10|Port & certificate" \
      "11|Update everything" "0|Exit"
    ch="$(ask "  ${B}Choose a number:${R} ")"
    case "$ch" in
      1) sub key; pause ;;
      2) clear_screen; ui_head "SERVERS"; print_servers || true; echo
         printf '  %s1%s connect   %s2%s remove   %s0%s back\n' "$A" "$R" "$A" "$R" "$A" "$R"
         case "$(ask "  Choose: ")" in
           1) n="$(ask "  Short name for it (e.g. iran): ")"; [ -n "$n" ] && sub add-server "$n" ;;
           2) n="$(ask "  Name to remove: ")"
              if [ -n "$n" ] && yes_no "Remove $n? Its access ends at once."; then
                if yes_no "Also uninstall FATLLM on $n (if online)?"; then sub remove-server "$n" --uninstall
                else sub remove-server "$n"; fi
              fi ;;
         esac
         pause ;;
      3) n="$(ask "  Name for the new server (e.g. iran): ")"; [ -n "$n" ] && sub add-server "$n"; pause ;;
      4) sub status; pause ;;
      5) sub log 30; pause ;;
      6) if agent_up; then yes_no "Turn access off?" && sub off
         else sub on; fi
         pause ;;
      7) yes_no "New main key? The old one stops." && sub rotate; pause ;;
      8) echo
         printf '  %s1%s 1 hour  %s2%s 24 hours  %s3%s 7 days  %s4%s never\n' "$A" "$R" "$A" "$R" "$A" "$R" "$A" "$R"
         case "$(ask "  Main key stops working after: ")" in
           1) sub expire 1h ;; 2) sub expire 24h ;; 3) sub expire 7d ;; 4) sub expire never ;; *) note "Unchanged." ;;
         esac
         pause ;;
      9) clear_screen; sub keys
         printf '  %s1%s add   %s2%s show   %s3%s remove   %s0%s back\n' "$A" "$R" "$A" "$R" "$A" "$R" "$A" "$R"
         case "$(ask "  Choose: ")" in
           1) n="$(ask "  Name for the new key (e.g. gpt): ")"; [ -n "$n" ] && sub keys add "$n" ;;
           2) n="$(ask "  Key name: ")"; [ -n "$n" ] && sub key "$n" ;;
           3) n="$(ask "  Key name to remove: ")"; [ -n "$n" ] && yes_no "Remove key $n?" && sub keys remove "$n" ;;
         esac
         pause ;;
      10) echo
          note "Now: port ${FATLLM_PORT:-?}, $(mode_label)."
          printf '  %s1%s new port  %s2%s self-signed  %s3%s public cert\n' "$A" "$R" "$A" "$R" "$A" "$R"
          case "$(ask "  Choose: ")" in
            1) p="$(ask "  New port (Enter = random 9001-9999): ")"; p="${p:-random}"
               if [ "$p" = random ] || [[ "$p" =~ ^[0-9]+$ ]]; then
                 yes_no "Move to port $p? (the key changes)" && sub port "$p"
               else warn "Not a number."; fi ;;
            2) sub mode direct ;;
            3) d="$(ask "  Your domain (Enter = <ip>.sslip.io): ")"; sub mode cert ${d:+--domain "$d"} ;;
          esac
          pause ;;
      11) sub update; pause ;;
      0 | q | Q | exit) clear_screen; exit 0 ;;
      *) ;;
    esac
  done
}

node_menu() {
  local ch con st
  while true; do
    load
    clear_screen
    ui_logo "connected server"
    IFS=$US read -r con _ _ _ < <(node_state)
    if agent_up && [ "$con" = True ]; then st="${G}${S_DOT:-*} connected${R}"
    elif agent_up; then st="${Y}${S_DOT:-*} connecting${R}"; else st="${RD}${S_DOT:-*} off${R}"; fi
    printf '  %s  %s%s%s\n' "$st" "$B" "${FATLLM_NAME:-?}" "$R"
    printf '  %shub%s %s\n' "$D" "$R" "${FATLLM_HUB:-?}"
    ui_rule
    echo
    if agent_up; then onoff="Turn access OFF"; else onoff="Turn access ON"; fi
    menu_items "1|Status" "2|Activity log" "3|$onoff" "4|Leave the hub" "0|Exit"
    ch="$(ask "  ${B}Choose a number:${R} ")"
    case "$ch" in
      1) sub status; pause ;;
      2) sub log 30; pause ;;
      3) if agent_up; then sub off; else sub on; fi; pause ;;
      4) sub leave; pause ;;
      0 | q | Q | exit) clear_screen; exit 0 ;;
      *) ;;
    esac
  done
}

usage() {
  ui_logo
  if [ -f "$CONF" ] && grep -q '^FATLLM_ROLE=node' "$CONF" 2>/dev/null; then
    ui_cmd "fatllm" "menu"
    ui_cmd "fatllm status" "connected to the hub?"
    ui_cmd "fatllm log [N]" "what the AI did here"
    ui_cmd "fatllm off / on" "cut / restore access"
    ui_cmd "fatllm leave" "remove FATLLM here"
    echo; return
  fi
  ui_head "EVERYDAY"
  ui_cmd "fatllm" "menu, every option"
  ui_cmd "fatllm key" "key + web panel link"
  ui_cmd "fatllm status" "running? servers?"
  ui_cmd "fatllm log [N]" "what the AI did"
  ui_head "SERVERS"
  ui_cmd "fatllm add-server N" "connect a server"
  ui_cmd "fatllm servers" "list them"
  ui_cmd "fatllm remove-server N" ""
  ui_head "SECURITY"
  ui_cmd "fatllm rotate" "new key, old one dies"
  ui_cmd "fatllm expire T" "30m|12h|7d|never"
  ui_cmd "fatllm keys" "extra keys"
  ui_cmd "fatllm off / on" "turn access off / on"
  ui_head "MAINTENANCE"
  ui_cmd "fatllm port N" "N or random"
  ui_cmd "fatllm mode M" "direct or cert"
  ui_cmd "fatllm update" "update hub + servers"
  ui_cmd "fatllm uninstall" "remove everything"
  echo
}

# ------------------------------------------------------------------ commands
if [ $# -eq 0 ] && [ -t 0 ] && [ -t 1 ]; then set -- menu; fi
cmd="${1:-}"
[ $# -gt 0 ] && shift
case "$cmd" in
  help | -h | --help) usage; exit 0 ;;
  version | --version) sed -n 's/^VERSION = "\(.*\)"/\1/p' "$APP/agent.py" 2>/dev/null; exit 0 ;;
esac
need_root "$cmd"
load

if is_node; then
  case "${cmd:-status}" in
    menu) node_menu ;;
    status | key | show | test | servers) node_status
      [ "$cmd" = key ] && note "Run 'fatllm key' on the hub (${FATLLM_HUB:-?})." ;;
    log | logs) show_log "${1:-40}" ;;
    off | stop) systemctl disable --now fatllm >/dev/null 2>&1 || true
      ok "Access to this server is off (fatllm on to restore)." ;;
    on | start) systemctl enable --now fatllm >/dev/null 2>&1; ui_wait "Connecting" 3; node_status ;;
    leave | uninstall | remove) node_leave "${1:-}" ;;
    update) note "Updates come from the hub: run 'fatllm update' there."
      note "It updates every connected server at once." ;;
    *) usage; exit 1 ;;
  esac
  exit 0
fi

case "${cmd:-key}" in
  menu) hub_menu ;;
  key | show) show_key "${1:-}" ;;
  status) show_status ;;
  log | logs)
    n=40 on=""
    while [ $# -gt 0 ]; do case "$1" in --on) on="${2:-}"; shift 2 ;; *) n="$1"; shift ;; esac; done
    show_log "$n" "$on" ;;
  servers | server)
    case "${1:-list}" in
      list | ls) ui_head "SERVERS"; print_servers; echo ;;
      add) shift; add_server "$@" ;;
      remove | rm) shift; remove_server "$@" ;;
      *) die "usage: fatllm servers [add NAME | remove NAME]" ;;
    esac ;;
  add-server | join) add_server "$@" ;;
  remove-server) remove_server "$@" ;;
  keys)
    case "${1:-list}" in
      list | ls) show_keys ;;
      add) [ -n "${2:-}" ] || die "usage: fatllm keys add NAME [7d]"
        adm add "$2" ${3:+"$3"} >/dev/null || exit 1
        ok "Key '$2' made (remove it any time)."
        show_key "$2" ;;
      show) show_key "${2:-}" ;;
      remove | rm) [ -n "${2:-}" ] || die "usage: fatllm keys remove NAME"
        adm remove "$2" >/dev/null || exit 1
        ok "Key '$2' removed; it stopped working." ;;
      *) die "usage: fatllm keys [add NAME [T] | show NAME | remove NAME]" ;;
    esac ;;
  rotate | new-key)
    adm rotate ${1:+"$1"} >/dev/null || exit 1
    ok "New key made; the old one stopped."
    note "Connected servers are not affected."
    show_key "${1:-}" ;;
  expire)
    [ -n "${1:-}" ] || die "usage: fatllm expire 30m | 12h | 7d | never [key name]"
    exp="$(adm expire "$1" ${2:+"$2"})" || exit 1
    if [ "$exp" = 0 ]; then ok "The key never expires."; else ok "Key stops working at $(fmt_time "$exp")."; fi ;;
  off | stop)
    # shellcheck disable=SC2046
    systemctl disable --now $(units) >/dev/null 2>&1 || true
    ok "Off. No key works until: fatllm on"
    note "Servers reconnect when it's back on." ;;
  on | start)
    # shellcheck disable=SC2046
    systemctl enable --now $(units) >/dev/null 2>&1
    for _ in $(seq 1 20); do api GET /info >/dev/null 2>&1 && break; ui_wait "Starting" 1; done
    ui_spin_end
    ok "FATLLM is on."
    show_key ;;
  test)
    if api GET /info >/dev/null; then ok "The agent answers (port ${FATLLM_PORT:-?})."
    else die "No answer. See: fatllm status"; fi ;;
  port)
    p="${1:-}"
    { [ "$p" = random ] || [[ "$p" =~ ^[0-9]+$ ]]; } || die "usage: fatllm port <number|random>   (now: ${FATLLM_PORT:-?})"
    run_installer --port "$p" ;;
  mode)
    m="${1:-}"; [ $# -gt 0 ] && shift
    case "$m" in
      direct | selfsigned | self-signed) run_installer --no-cert "$@" ;;
      cert | caddy | public) run_installer --cert "$@" ;;
      tunnel) die "the tunnel mode was removed: it was unstable. 'direct' (default) works everywhere." ;;
      *) die "usage: fatllm mode direct | cert [--domain NAME]" ;;
    esac ;;
  update)
    run_installer "$@" ;;
  uninstall | remove)
    yes=0 all=0
    for o in "$@"; do case "$o" in -y) yes=1 ;; --all) all=1 ;; esac; done
    if [ "$yes" = 0 ]; then
      printf '  Remove FATLLM and all keys? Type %syes%s: ' "$B" "$R"
      read -r ans </dev/tty || ans=""
      [ "$ans" = yes ] || { note "Cancelled."; exit 0; }
      if [ "$all" = 0 ] && agent_up && [ -n "$(servers_tsv 2>/dev/null | awk -F'\037' '$2!="hub"')" ]; then
        yes_no "Also remove it from connected servers?" && all=1
      fi
    fi
    if [ "$all" = 1 ] && agent_up; then
      while IFS=$US read -r n s _; do
        [ "$s" = hub ] && continue
        if api POST /admin/servers/remove "{\"name\": \"$n\", \"uninstall\": true}" 2>/dev/null | grep -q '"uninstalled": true'; then
          ok "Removed from $n"
        else warn "$n: offline; there run 'fatllm leave'"; fi
      done < <(servers_tsv 2>/dev/null || true)
    fi
    uninstall_local
    note "Every key stopped working." ;;
  *) usage; exit 1 ;;
esac
